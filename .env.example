# Copy this file to ".env" and fill in the real values. Never commit .env.

# ── Shown in the browser (safe to be public) ─────────────────────────────
# PayPal: developer.paypal.com → Apps & Credentials → Live → your app → Client ID
# Leave as "test" to keep the sandbox (no real charges).
VITE_PAYPAL_CLIENT_ID=test
# Rate used to convert KSh prices to USD for card / PayPal payments
VITE_KES_PER_USD=129
# WhatsApp number that receives orders (digits only, country code first)
VITE_WHATSAPP=447883387789
# Optional: show a manual "pay to till" line under M-Pesa
VITE_MPESA_TILL=
VITE_MPESA_TILL_NAME=FLAW ENFORCEMENT

# ── Server only (secret) : M-Pesa Daraja, developer.safaricom.co.ke ───────
# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or till "store" number, and its Lipa na M-Pesa Online passkey
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Paybill: CustomerPayBillOnline   |   Till (Buy Goods): CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Only for tills: the till number customers pay to
MPESA_PARTY_B=
# Public https URL of this site + /api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
